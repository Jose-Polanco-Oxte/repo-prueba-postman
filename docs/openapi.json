{
  "openapi": "3.0.3",
  "info": {
    "title": "Users API Demo",
    "version": "1.0.0",
    "description": "CRUD educativo. Datos en memoria; POST /users es publico. Cualquier usuario autenticado puede administrar todos los usuarios."
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {
              "users:read": "Leer usuarios",
              "users:write": "Modificar usuarios"
            }
          }
        }
      }
    },
    "schemas": {}
  },
